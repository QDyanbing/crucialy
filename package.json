{
  "name": "crucialy",
  "version": "0.0.0",
  "private": true,
  "description": "Crucialy monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "crucialy setup",
    "lint": "pnpm -r lint",
    "prepare": "husky",
    "release": "pnpm build && changeset publish && git push origin master --follow-tags",
    "release:prepare": "changeset version",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.7",
    "@crucialy/git-hooks": "file:../crucialy-git-hooks",
    "@crucialy/lint": "workspace:^",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "22.14.0",
    "pnpm": "8.6.11"
  }
}

{
  "name": "crucialy",
  "version": "0.0.0",
  "private": true,
  "description": "Crucialy monorepo",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "release:prepare": "changeset version",
    "release": "pnpm build && changeset publish && git push origin main --follow-tags"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.7",
    "@crucialy/git-hooks": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "22.14.0",
    "pnpm": "8.6.11"
  }
}


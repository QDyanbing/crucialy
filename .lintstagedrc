{
  "**/*.{js,jsx}": ["eslint --max-warnings=0 --fix", "prettier --write"],
  "**/*.{ts,tsx}": ["prettier --write"],
  "**/*.vue": ["eslint --max-warnings=0 --fix", "stylelint --fix", "prettier --write"],
  "**/*.{css,scss,less}": ["stylelint --fix", "prettier --write"],
  "**/*.{json,md,yaml,yml}": ["prettier --write"]
}

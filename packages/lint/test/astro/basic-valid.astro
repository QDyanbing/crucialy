---
// basic-valid.astro - Astro 组件中的样式有效示例
const title = 'Hello';
---

<html>
  <body>
    <h1 class="title">{title}</h1>
  </body>
</html>

<style>
  .title {
    color: red;
    font-size: 24px;
  }

  /* Astro 全局选择器 */
  :global(body) {
    margin: 0;
  }

  :global(.global-class) {
    padding: 16px;
  }
</style>


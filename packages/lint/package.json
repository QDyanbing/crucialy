{
  "name": "@crucialy/lint",
  "version": "0.0.0",
  "description": "Opinionated lint configurations for ESLint, Stylelint, and Prettier",
  "keywords": [
    "eslint",
    "eslint-config",
    "stylelint",
    "stylelint-config",
    "prettier",
    "prettier-config",
    "lint",
    "config",
    "react",
    "vue"
  ],
  "homepage": "https://github.com/crucialy/crucialy/tree/master/packages/lint#readme",
  "bugs": {
    "url": "https://github.com/crucialy/crucialy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crucialy/crucialy.git",
    "directory": "packages/lint"
  },
  "license": "MIT",
  "author": {
    "name": "gaoyanbing",
    "email": "yanbing.gao@aliyun.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./prettier": {
      "types": "./dist/prettier/index.d.ts",
      "require": "./dist/prettier/index.js",
      "import": "./dist/prettier/index.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "require": "./dist/eslint/index.js",
      "import": "./dist/eslint/index.mjs"
    },
    "./eslint/react": {
      "types": "./dist/eslint/react.d.ts",
      "require": "./dist/eslint/react.js",
      "import": "./dist/eslint/react.mjs"
    },
    "./eslint/vue": {
      "types": "./dist/eslint/vue.d.ts",
      "require": "./dist/eslint/vue.js",
      "import": "./dist/eslint/vue.mjs"
    },
    "./stylelint": {
      "types": "./dist/stylelint/index.d.ts",
      "require": "./dist/stylelint/index.js",
      "import": "./dist/stylelint/index.mjs"
    },
    "./stylelint/*": {
      "types": "./dist/stylelint/*.d.ts",
      "require": "./dist/stylelint/*.js",
      "import": "./dist/stylelint/*.mjs"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",


    
    "generate:stylelint-rule-sets": "node scripts/generate-stylelint-rule-sets.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^3.0.0",
    "stylelint": "^16.0.0",
    "stylelint-less": "^3.0.0",
    "stylelint-order": "^6.0.0",
    "stylelint-scss": "^6.0.0",
    "stylelint-stylus": "^0.18.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "@stylelint/postcss-css-in-js": ">=0.38.0",
    "eslint": ">=8.0.0",
    "postcss-html": ">=1.0.0",
    "postcss-less": ">=6.0.0",
    "postcss-scss": ">=4.0.0",
    "prettier": ">=3.0.0",
    "prettier-plugin-organize-attributes": ">=1.0.0",
    "prettier-plugin-organize-imports": ">=3.0.0",
    "prettier-plugin-packagejson": ">=2.0.0",
    "prettier-plugin-tailwindcss": ">=0.5.0",
    "stylelint": ">=14.0.0",
    "stylelint-declaration-block-no-ignored-properties": ">=2.0.0",
    "stylelint-order": ">=6.0.0",
    "stylelint-scss": ">=5.0.0 || >=6.0.0"
  },
  "peerDependenciesMeta": {
    "@stylelint/postcss-css-in-js": {
      "optional": true
    },
    "postcss-html": {
      "optional": true
    },
    "postcss-less": {
      "optional": true
    },
    "postcss-scss": {
      "optional": true
    },
    "prettier-plugin-organize-attributes": {
      "optional": true
    },
    "prettier-plugin-organize-imports": {
      "optional": true
    },
    "prettier-plugin-packagejson": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    },
    "stylelint-declaration-block-no-ignored-properties": {
      "optional": true
    },
    "stylelint-order": {
      "optional": true
    },
    "stylelint-scss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
